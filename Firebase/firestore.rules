rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // PREMIUM HELPERS (CHỈ BỔ SUNG – KHÔNG PHÁ CŨ)
    // ==========================================================
    function premiumDoc(uid) {
      return get(/databases/$(database)/documents/premiumStatus/$(uid));
    }

    function isPremium(uid) {
      return exists(/databases/$(database)/documents/premiumStatus/$(uid)) &&
             premiumDoc(uid).data.isPremium == true;
    }

    function tier(uid) {
      return exists(/databases/$(database)/documents/premiumStatus/$(uid))
        ? premiumDoc(uid).data.tier
        : "free";
    }

    function isPro(uid) {
      return tier(uid) == "pro";
    }

    // ----------------------------------------------------------
    // EVENTS
    // ----------------------------------------------------------
 match /events/{eventId} {

  function isParticipant() {
    return request.auth.uid in resource.data.participants;
  }

  function isAdmin() {
    return resource.data.admins != null &&
           request.auth.uid in resource.data.admins;
  }

  function isLegacyOwner() {
    return request.auth.uid == resource.data.owner ||
           request.auth.uid == resource.data.createdBy;
  }

  // ================= READ =================
  allow read: if
    request.auth != null &&
    (
      // new model
      isParticipant()
      ||
      // legacy fallback
      isLegacyOwner()
    );

  // ================= CREATE =================
  allow create: if
    request.auth != null &&
    request.resource.data.createdBy == request.auth.uid &&
    request.resource.data.participants is list &&
    request.resource.data.participants.size() >= 1 &&
    request.resource.data.participants.size() <= 5 && // ⭐ max group

    // creator must be in participants
    request.auth.uid in request.resource.data.participants &&

    // admins (new)
    (
      !("admins" in request.resource.data) ||
      request.auth.uid in request.resource.data.admins
    );

  // ================= UPDATE / DELETE =================
  allow update, delete: if
    request.auth != null &&
    (
      // new model
      isAdmin()
      ||
      // legacy fallback
      isLegacyOwner()
    );

  // ================= RESPONSES / PROPOSALS (v2.4) =================
  // Any participant (not only admins) may record THEIR OWN answer
  // (responses.<uid>), propose a new time, and vote on a proposal.
  function onlyOwnResponse() {
    let before = resource.data.get("responses", {});
    let after = request.resource.data.get("responses", {});
    return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
  }

  // Only my own entries in proposal.accepted / proposal.rejected changed.
  function onlyMyVote(before, after) {
    let accB = before.get("accepted", [before.by]).toSet();
    let accA = after.get("accepted", []).toSet();
    let rejB = before.get("rejected", []).toSet();
    let rejA = after.get("rejected", []).toSet();
    return accA.difference(accB)
             .union(accB.difference(accA))
             .union(rejA.difference(rejB))
             .union(rejB.difference(rejA))
             .hasOnly([request.auth.uid]);
  }

  function proposalOk() {
    let before = resource.data.get("proposal", null);
    let after = request.resource.data.get("proposal", null);
    // unchanged
    return after == before ||
      // new proposal (or replacing my own)
      (after != null && after.by == request.auth.uid &&
        (before == null || before.by == request.auth.uid)) ||
      // vote on the current proposal
      (after != null && before != null &&
        after.by == before.by && after.start == before.start && after.end == before.end &&
        after.keys().hasOnly(["by", "start", "end", "accepted", "rejected"]) &&
        onlyMyVote(before, after)) ||
      // proposer withdraws
      (after == null && before != null && before.by == request.auth.uid) ||
      // my "no" makes a majority impossible → drop it
      (after == null && before != null &&
        before.get("rejected", []).toSet().union([request.auth.uid].toSet()).size() * 2
          >= resource.data.participants.size());
  }

  allow update: if
    request.auth != null &&
    isParticipant() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(["responses", "proposal"]) &&
    onlyOwnResponse() &&
    proposalOk();

  // More than half agreed (my "yes" included) → I may move the appointment to
  // exactly the proposed time for everyone and clear the proposal.
  function appliesMajorityProposal() {
    let p = resource.data.get("proposal", null);
    return p != null &&
      request.resource.data.get("proposal", null) == null &&
      request.resource.data.startTime == p.start &&
      request.resource.data.endTime == p.end &&
      p.get("accepted", [p.by]).toSet().union([request.auth.uid].toSet()).size() * 2
        > resource.data.participants.size();
  }

  allow update: if
    request.auth != null &&
    isParticipant() &&
    request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(["date", "startTime", "endTime", "proposal", "responses"]) &&
    appliesMajorityProposal();
}


    // ----------------------------------------------------------
    // PUBLIC CALENDAR
    // ----------------------------------------------------------
  match /publicCalendar/{userId} {
  allow read: if true;

  // Chủ lịch ghi được mọi field. Người khác CHỈ được sửa busySlots
  // (+ updatedAt — trang web ghi kèm khi đồng bộ giờ bận) — không đụng
  // được tier / isPremium / offDays của người khác.
  allow write: if
    request.auth != null &&
    request.resource.data.keys().hasOnly([
      "busySlots",
      "offDays",
      "isPremium",
      "tier",
      "updatedAt",
      "bookingHours"   // v2.5: giờ nhận lịch (chỉ chủ lịch ghi — xem các nhánh dưới)
    ]) &&
    (
      request.auth.uid == userId ||
      (
        resource != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["busySlots", "updatedAt"])
      ) ||
      // Chủ lịch chưa có doc: người đặt lịch (app cũ / web) được tạo doc
      // với giá trị MẶC ĐỊNH (free, không ngày nghỉ) + busySlots.
      (
        resource == null &&
        request.resource.data.get("tier", "free") == "free" &&
        request.resource.data.get("isPremium", false) == false &&
        request.resource.data.get("offDays", []).size() == 0 &&
        !("bookingHours" in request.resource.data)
      )
    );
}

// ----------------------------------------------------------
// HANDLES (v2.5) — link đặt lịch dễ nhớ: /c/{handle} → uid
// ----------------------------------------------------------
match /handles/{handle} {
  allow read: if true;

  // Tạo handle cho CHÍNH MÌNH: 3–30 ký tự a-z 0-9 '-', không bắt đầu/kết thúc bằng '-'
  allow create: if
    request.auth != null &&
    handle.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$') &&
    request.resource.data.keys().hasOnly(["uid", "createdAt"]) &&
    request.resource.data.uid == request.auth.uid;

  // Chỉ chủ handle được xoá (đổi link = tạo mới + xoá cũ)
  allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
}

// ----------------------------------------------------------
// SHARED LINKS (Mutual friend-style links)
// ----------------------------------------------------------
match /sharedLinks/{userId} {

  match /links/{otherUid} {

    // User chỉ được đọc links của chính mình
    allow read: if request.auth != null &&
                request.auth.uid == userId;

    // User chỉ được ghi links của chính mình
    allow write: if request.auth != null &&
                 request.auth.uid == userId;
  }
}

    // ----------------------------------------------------------
    // USERS
    // ----------------------------------------------------------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // ----------------------------------------------------------
    // PREMIUM STATUS (SYNC PREMIUM / PRO)
    // ----------------------------------------------------------
    match /premiumStatus/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if
        request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          "tier",
          "isPremium",
          "updatedAt"
        ]);
    }

    // ----------------------------------------------------------
    // CALENDAR ACCESS
    // ----------------------------------------------------------
    match /calendarAccess/{ownerId} {

      match /allowed/{otherId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == ownerId;
      }

     match /requests/{requesterId} {
  allow read: if request.auth != null;

  allow create, update: if request.auth.uid == requesterId;

  allow delete: if request.auth.uid == ownerId;
}

    }

    // ----------------------------------------------------------
    // CHATS — chỉ người trong cuộc hẹn mới đọc/ghi được
    // ----------------------------------------------------------
    match /chats/{eventId} {

      // Người tham gia sự kiện (events/{eventId}.participants)
      function inEvent() {
        return exists(/databases/$(database)/documents/events/$(eventId)) &&
               request.auth.uid in
                 get(/databases/$(database)/documents/events/$(eventId)).data.participants;
      }

      // Người có tên trong chats/{eventId}.participants
      function inChat() {
        return exists(/databases/$(database)/documents/chats/$(eventId)) &&
               request.auth.uid in
                 get(/databases/$(database)/documents/chats/$(eventId)).data.participants;
      }

      function isMember() {
        return request.auth != null && (inChat() || inEvent());
      }

      // Chat metadata
      allow read: if isMember();
      // Tạo chat: phải là người tham gia sự kiện (không tự thêm mình vào chat người khác)
      allow create: if request.auth != null && inEvent();
      // Sửa/xoá: kiểm tra theo danh sách HIỆN TẠI (trước khi sửa)
      allow update, delete: if isMember();

      // ---------------------- MESSAGES -------------------------
      match /messages/{messageId} {

        allow read: if isMember();

        allow create: if
          request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&

          request.resource.data.keys().hasOnly([
            "text",
            "senderId",
            "senderName",
            "timestamp",
            "seenBy",
            "latitude",
            "longitude"
          ]) &&

          exists(/databases/$(database)/documents/chats/$(eventId)) &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(eventId))
              .data.participants &&

          request.time <
            get(/databases/$(database)/documents/chats/$(eventId))
              .data.eventEndTime &&

          (
            (request.resource.data.text is string &&
             request.resource.data.text.size() > 0)
            ||
            (request.resource.data.latitude is number &&
             request.resource.data.longitude is number)
          );

        allow update: if
          isMember() &&
          request.resource.data.diff(resource.data).affectedKeys()
  .hasOnly(["seenBy", "lastMessage", "lastMessageTime", "unread", "freeCount"])
;

        allow delete: if false;
      }

      // ---------------------- TODOS ----------------------------
      match /todos/{todoId} {

        allow read: if isMember();

        allow create: if
          request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/events/$(eventId))
              .data.participants &&
          request.resource.data.keys().hasOnly([
            "text",
            "doneBy",
            "createdAt",
            "createdBy"
          ]) &&
          request.resource.data.createdBy == request.auth.uid;

        allow update: if
          request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/events/$(eventId))
              .data.participants;

        allow delete: if
          request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/events/$(eventId))
              .data.participants;
      }
    } // END /chats
  }
}
